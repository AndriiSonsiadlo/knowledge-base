{
	"extends": "@docusaurus/tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@components/*": ["./src/components/*"],
			"@css/*": ["./src/css/*"],
			"@lib/*": ["./src/lib/*"],
			"@pages/*": ["./src/pages/*"],
			"@plugins/*": ["./src/plugins/*"]
		},
		"noEmit": true
	},
	"include": ["src"],
	"exclude": [".docusaurus", "build", "node_modules", "dist"]
}
